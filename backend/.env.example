# --- Server ---
PORT=
NODE_ENV=

# --- Database ---
MONGODB_URI=

# --- Auth: each must be a long random value (16+ chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_LECTURER_SECRET=
JWT_STUDENT_SECRET=

# --- Browsers allowed to call this API (comma-separated exact origins, no paths).
# Also used by the CSRF Origin check.
CORS_ORIGINS=

# --- Cookies: leave unset unless frontend and backend share a parent domain
# (e.g. app.school.edu + api.school.edu), then set to lax.
# COOKIE_SAMESITE=lax

# --- Deadline sweep ---
# Shared secret for POST /internal/sweep (external cron).
SWEEP_SECRET=
# In-process sweep interval in seconds. 0 disables it (use the external cron only).
SWEEP_INTERVAL_SECONDS=

# --- AI question generation (Google Gemini) ---
LLM_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_REQUEST_TIMEOUT_MS=
LLM_TOTAL_TIMEOUT_MS=
AI_GENERATIONS_PER_TEST=
AI_GENERATIONS_PER_LECTURER_PER_HOUR=
AI_MAX_QUESTIONS_PER_RUN=